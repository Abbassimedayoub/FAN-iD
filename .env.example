# ==============================================================================
# FAN id — Environment variables
# Copy to .env (never commit it): cp .env.example .env
# The application refuses to start when a critical variable is missing.
# ==============================================================================

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY='django-insecure-fanid-example-only-not-real-00000000000000000000' # pragma: allowlist secret - random because sensitive
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COMMIT_SHA=local-dev
APP_VERSION=0.1.0-sprint0

# --- PostgreSQL ---
POSTGRES_DB=fanid
POSTGRES_USER=fanid
POSTGRES_PASSWORD='fanid-example-password-not-real' # pragma: allowlist secret - random because sensitive
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15433
DATABASE_URL='postgresql://fanid:fanid-example-password-not-real@postgres:5432/fanid' # pragma: allowlist secret - random because sensitive

# --- Redis (cache + locks + sessions + channel layer + Celery broker; one service) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=16380
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=0
REDIS_CHANNEL_LAYER_DB=1
REDIS_LOCK_DB=2
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# --- Secrets (SecretProvider port; EnvSecretProvider in development) ---
SECRET_PROVIDER=env

# Notification channel. 'console' logs instead of sending: DEVELOPMENT ONLY.
NOTIFICATION_BACKEND=console

# Device lock backend: resilient, redis, or postgres.
DEVICE_LOCK_BACKEND=resilient
# Production only (SsmSecretProvider):
AWS_REGION=eu-west-3
SSM_PARAMETER_PREFIX=/fanid/dev/

# --- Authentication: refresh cookie and CSRF ---
# No production domain exists yet; these values are local.
# Empty REFRESH_COOKIE_DOMAIN means a host-bound cookie, which is the safe default.
REFRESH_COOKIE_NAME=fanid_refresh
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_PATH=/api/v1/auth
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# --- Idempotency / Outbox ---
IDEMPOTENCY_RETENTION_HOURS=24
IDEMPOTENCY_ORPHAN_GUARD_SECONDS=60
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_INTERVAL_SECONDS=2
OUTBOX_STUCK_AFTER_SECONDS=30
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=30

# --- Observability (OTel) ---
OTEL_SERVICE_NAME=fanid-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# --- Health / readiness ---
HEALTH_DEPENDENCY_TIMEOUT_SECONDS=2

# --- Rate limiting (DRF throttling; scopes are defined by feature code) ---
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=300/min

# --- Web frontend (Vite; VITE_ prefix required, not NEXT_PUBLIC_) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_ENV=development

# --- Mobile (consumed through --dart-define; not read by docker-compose) ---
# MOBILE_API_URL=http://10.0.2.2:8000

# --- External adapters ---
# Fake examples preserve provider formats; never replace production secrets with these values.
STRIPE_SECRET_KEY='sk_test_51FANIDEXAMPLEONLY0000000000000000000000000000' # pragma: allowlist secret - random because sensitive
STRIPE_WEBHOOK_SECRET='whsec_FANIDEXAMPLEONLY000000000000000000000000' # pragma: allowlist secret - random because sensitive

# Cloudflare R2 object storage.
R2_ACCOUNT_ID='0123456789abcdef0123456789abcdef' # pragma: allowlist secret - random because sensitive
R2_BUCKET=fanid-demo-private
R2_ACCESS_KEY_ID='0123456789abcdef0123456789abcdef' # pragma: allowlist secret - random because sensitive
R2_SECRET_ACCESS_KEY='0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef' # pragma: allowlist secret - random because sensitive

# Real SMTP configuration for email notifications.
# Set NOTIFICATION_BACKEND=smtp to enable it.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER='fanid-demo@example.invalid' # pragma: allowlist secret - random because sensitive
EMAIL_HOST_PASSWORD='abcdefghijklmnop' # pragma: allowlist secret - random because sensitive
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=FANID <notifications@example.invalid>
EMAIL_TIMEOUT=10

# --- JWT tokens ---
# Generate a value DISTINCT from DJANGO_SECRET_KEY, >= 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY='fanid-jwt-example-not-real-000000000000000000000000000000000000' # pragma: allowlist secret - random because sensitive
QR_SIGNING_KEY='fanid-qr-example-not-real-0000000000000000000000000000000000000' # pragma: allowlist secret - random because sensitive
JWT_ALGORITHM=HS256
JWT_ISSUER=fanid-api
JWT_LEEWAY_SECONDS=10
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7


# --- GitHub Actions / Cloudflare Pages deployment reference ---
# These values are configured in GitHub repository secrets/variables, not loaded by Django.
# CLOUDFLARE_ACCOUNT_ID='fedcba9876543210fedcba9876543210' # pragma: allowlist secret - random because sensitive
# CLOUDFLARE_API_TOKEN='fanid_cloudflare_example_token_not_real_0000000000' # pragma: allowlist secret - random because sensitive
# CLOUDFLARE_PAGES_PROJECT=fan-id
# PRODUCTION_API_URL=https://fanid-api-9sep.onrender.com
