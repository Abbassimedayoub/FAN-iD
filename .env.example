# ==============================================================================
# FAN id — Variables d'environnement (Sprint 0)
# Copier en .env (jamais commité) : cp .env.example .env
# L'application REFUSE de démarrer si une variable critique manque (§40/§41).
# ==============================================================================

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me-in-prod-min-50-chars-xxxxxxxxxx
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COMMIT_SHA=local-dev
APP_VERSION=0.1.0-sprint0

# --- PostgreSQL ---
POSTGRES_DB=fanid
POSTGRES_USER=fanid
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15433
DATABASE_URL=postgresql://fanid:dev-only-change-me@postgres:5432/fanid

# --- Redis (cache + verrous + sessions + channel layer + broker Celery — service unique, §2.1) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=16380
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=0
REDIS_CHANNEL_LAYER_DB=1
REDIS_LOCK_DB=2
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# --- Secrets (SecretProvider port — EnvSecretProvider en dev, §2.3) ---
SECRET_PROVIDER=env

# Canal de notification. 'console' journalise au lieu d'envoyer : DEV UNIQUEMENT.
NOTIFICATION_BACKEND=console

# Verrou d'appareil : resilient, redis ou postgres.
DEVICE_LOCK_BACKEND=resilient
# En prod uniquement (SsmSecretProvider) :
AWS_REGION=eu-west-3
SSM_PARAMETER_PREFIX=/fanid/dev/

# --- Authentification Sprint 1 : cookie de refresh, CSRF (§18/§70) ---
# Aucun domaine de production n'existe encore : ces valeurs sont locales.
# REFRESH_COOKIE_DOMAIN vide = cookie lié à l'hôte (bon défaut).
REFRESH_COOKIE_NAME=fanid_refresh
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_PATH=/api/v1/auth
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# --- Idempotency / Outbox (core, §3.1) ---
IDEMPOTENCY_RETENTION_HOURS=24
IDEMPOTENCY_ORPHAN_GUARD_SECONDS=60
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_INTERVAL_SECONDS=2
OUTBOX_STUCK_AFTER_SECONDS=30
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=30

# --- Observabilité (OTel) ---
OTEL_SERVICE_NAME=fanid-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# --- Health / readiness ---
HEALTH_DEPENDENCY_TIMEOUT_SECONDS=2

# --- Rate limiting (DRF throttling, §5.1 — portées définies aux sprints suivants) ---
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=300/min

# --- Frontend web (Vite — préfixe VITE_ obligatoire, PAS NEXT_PUBLIC_, §4.3) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_ENV=development

# --- Mobile (à consommer via --dart-define, non lu par docker-compose) ---
# MOBILE_API_URL=http://10.0.2.2:8000

# --- Adaptateurs externes (ports définis au S0, implémentés aux sprints suivants —
#     laissés vides ici : le S0 n'appelle aucun de ces services) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# QR_SEED_ENCRYPTION_KEY=
# AWS_S3_BUCKET=
# SMTP réel pour les notifications e-mail.
# Mettre NOTIFICATION_BACKEND=smtp pour l'activer.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=FANID <notifications@example.com>
# EMAIL_TIMEOUT=10
# SES_FROM_EMAIL=
# FCM_SERVER_KEY=

# --- Jetons JWT ---
# Generer une valeur DISTINCTE de DJANGO_SECRET_KEY, >= 32 octets :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=fanid-api
JWT_LEEWAY_SECONDS=10
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7
