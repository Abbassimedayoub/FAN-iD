[importlinter]
root_package = apps
include_external_packages = True

# Regle absolue (ADR-S-01) : core ne depend d aucun bounded context metier.
[importlinter:contract:core-is-independent]
name = core must not depend on any bounded context
type = forbidden
source_modules =
    apps.core
forbidden_modules =
    apps.identity
    apps.organizing
    apps.catalog
    apps.ordering
    apps.payments
    apps.ticketing
    apps.access
    apps.notifying
    apps.realtime
ignore_imports =
    # Integration tests may compose bounded contexts; production code may not.
    apps.core.tests.** -> apps.**

# Les contextes SANS communication synchrone restent mutuellement independants.
# `organizing` puis `catalog` en sont retires lorsqu ils portent une
# dependance synchrone explicite, encadree par un contrat public dedie.
[importlinter:contract:contexts-are-independent]
name = bounded contexts must not import each other directly
type = independence
modules =
    apps.identity
    apps.ordering
    apps.payments
    apps.ticketing
    apps.access
    apps.notifying
    apps.realtime
ignore_imports =
    # Integration tests may compose bounded contexts; production code may not.
    apps.*.tests.** -> apps.**

    # Explicit public boundaries. Internal models, services and tasks remain forbidden.
    apps.access.admin_dashboard_views -> apps.identity.api
    apps.access.services.admissions -> apps.ticketing.api
    apps.access.services.live_dashboard -> apps.ticketing.api
    apps.access.services.final_reports -> apps.ordering.api
    apps.access.services.final_reports -> apps.payments.api
    apps.access.services.final_reports -> apps.ticketing.api
    apps.ordering.services.confirmation -> apps.ticketing.api
    apps.payments.services.intents -> apps.ordering.api
    apps.payments.services.refunds -> apps.ordering.api
    apps.payments.services.refunds -> apps.ticketing.api
    apps.ticketing.services.issuance -> apps.ordering.api
    apps.notifying.event_buyer_tasks -> apps.ticketing.api
    apps.notifying.refund_notification_consumers -> apps.payments.events
    apps.notifying.refund_notification_tasks -> apps.payments.api
    apps.notifying.final_report_consumers -> apps.access.events
    apps.notifying.final_report_tasks -> apps.access.api
    apps.ticketing.services.transfers -> apps.identity.api
    apps.notifying.ticket_transfer_consumers -> apps.ticketing.events
    apps.notifying.ticket_transfer_tasks -> apps.ticketing.api

# ADR-S1-05 : le sens de la dependance suit le domaine. Un compte existe sans
# organisateur ; l inverse est impossible. `identity` ignore donc totalement
# l existence des autres contextes — contrat PLUS STRICT que l independance
# generique, et c est lui qui garantit l absence de cycle.
[importlinter:contract:identity-is-independent]
name = identity must not depend on any bounded context
type = forbidden
source_modules =
    apps.identity
forbidden_modules =
    apps.organizing
    apps.catalog
    apps.ordering
    apps.payments
    apps.ticketing
    apps.access
    apps.notifying
    apps.realtime

# Liste BLANCHE, pas liste noire : `apps.identity` est interdit en entier,
# descendants compris, et une seule exception est declaree. Un module ajoute
# demain dans `identity` est donc interdit par defaut — ce qui manquait a la
# strategie M-3 de l audit, qui se rabattait sur la revue de code.
#
# `unmatched_ignore_imports_alerting` vaut `error` par defaut : le jour ou plus
# personne n importera `identity.api` depuis `organizing`, cette derogation
# devenue inutile fera echouer la CI au lieu de dormir ici.
[importlinter:contract:organizing-reaches-identity-through-api-only]
name = organizing may only reach identity through its public api
type = forbidden
source_modules =
    apps.organizing
forbidden_modules =
    apps.identity
    apps.catalog
    apps.ordering
    apps.payments
    apps.ticketing
    apps.access
    apps.notifying
    apps.realtime
ignore_imports =
    apps.organizing.** -> apps.identity.api
    # Integration tests may compose bounded contexts; production code may not.
    apps.organizing.tests.** -> apps.**

# Sprint 2 : catalog a besoin de deux collaborations synchrones explicites :
# - identity.api pour la politique d autorisation ;
# - organizing.api pour le contexte organisateur.
#
# Les deux exceptions sont des interfaces publiques. Tous les autres imports
# inter-contextes restent interdits, y compris services/, models.py et
# permissions.py internes.
[importlinter:contract:catalog-reaches-contexts-through-public-apis-only]
name = catalog may only reach bounded contexts through public apis
type = forbidden
source_modules =
    apps.catalog
forbidden_modules =
    apps.identity
    apps.organizing
    apps.ordering
    apps.payments
    apps.ticketing
    apps.access
    apps.notifying
    apps.realtime
ignore_imports =
    apps.catalog.** -> apps.identity.api
    apps.catalog.** -> apps.organizing.api
    # Integration tests may compose bounded contexts; production code may not.
    apps.catalog.tests.** -> apps.**
