# Surcharges pour exécuter le backend et la suite de tests HORS Docker.
#
# Le .env principal porte les noms d'hôtes Docker (postgres, redis), qui ne
# résolvent pas depuis la machine hôte : INSTALL.md §5 prescrivait `pytest` sec
# et était donc inapplicable tel quel (P1-000). Les ports ci-dessous sont ceux
# publiés par docker-compose.yml.
#
#   docker compose up -d postgres redis
#   set -a && . ./.env.local && set +a
#   cd backend && pytest -n auto
#
DATABASE_URL=postgresql://fanid:dev-only-change-me@localhost:55433/fanid
REDIS_URL=redis://localhost:56380/0
CELERY_BROKER_URL=redis://localhost:56380/3
CELERY_RESULT_BACKEND=redis://localhost:56380/4
DJANGO_SETTINGS_MODULE=config.settings.test
