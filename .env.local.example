# Overrides for running the backend and test suite OUTSIDE Docker.
#
# The main .env uses Docker hostnames (postgres, redis), which do not resolve
# from the host machine. The ports below are the ones published by
# docker-compose.yml.
#
#   docker compose up -d postgres redis
#   set -a && . ./.env.local && set +a
#   cd backend && pytest -n auto
#
DATABASE_URL=postgresql://fanid:dev-only-change-me@localhost:15433/fanid
REDIS_URL=redis://localhost:16380/0
CELERY_BROKER_URL=redis://localhost:16380/3
CELERY_RESULT_BACKEND=redis://localhost:16380/4
DJANGO_SETTINGS_MODULE=config.settings.test
