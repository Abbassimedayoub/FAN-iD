# cp .env.example .env (dans web/) pour le développement local du frontend
# (lancé hors Docker via `npm run dev` — Vite n'est pas un service du
# docker-compose.yml du Sprint 0, cf. §2.1 Source B : 8 services, tous backend/infra).
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_ENV=development
